# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eshop_chatbot
DB_USER=postgres
DB_PASSWORD=your_password_here

# AI NLP Configuration
NLP_MODEL_NAME=facebook/bart-large-mnli
NLP_CONFIDENCE_THRESHOLD=0.4
NLP_AMBIGUITY_THRESHOLD=0.1
# NLP_INTENT_LABELS=greeting,order status inquiry,return policy question

# Colab API Configuration (TinyLlama model via ngrok)
# Update COLAB_API_URL with your ngrok URL when running the model in Colab
COLAB_API_URL=https://your-ngrok-url.ngrok-free.app
COLAB_API_TIMEOUT=30
COLAB_API_ENABLED=true
