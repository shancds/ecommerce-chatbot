# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eshop_chatbot
DB_USER=postgres
DB_PASSWORD=your_password_here

# AI NLP Configuration
NLP_MODEL_NAME=facebook/bart-large-mnli
NLP_CONFIDENCE_THRESHOLD=0.4
NLP_AMBIGUITY_THRESHOLD=0.1
# NLP_INTENT_LABELS=greeting,order status inquiry,return policy question

# OpenAI-Compatible Model Configuration (AIML API)
OPENAI_API_BASE_URL=https://api.aimlapi.com/v1
OPENAI_API_KEY=your_aiml_api_key_here
OPENAI_MODEL_NAME=openai/gpt-oss-20b
OPENAI_ENABLED=true
OPENAI_TIMEOUT=30
OPENAI_WEIGHT=0.6
HUGGINGFACE_WEIGHT=0.4
